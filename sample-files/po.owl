    <!-- http://purl.obolibrary.org/obo/PO_0025527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025338"/>
        <rdfs:subClassOf>
