        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025570"/>
        <obo:IAO_0000115>A vascular leaf development stage (PO:0025570) which begins with the onset of the vascular leaf anlagen formation stage (PO:0001003) and ends with the termination of the vascular leaf primordium polarity determination stage (PO:0001052).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:556</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
