    <!-- http://purl.obolibrary.org/obo/PO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009011"/>
        <obo:IAO_0000115>A plant structure (PO:0009011) that is grown or maintained in vitro.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:64</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>estructura vegetal in vito (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>培養下植物構造 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0000004</oboInOwl:id>
        <rdfs:comment>In vitro growth is defined as microbe-free growth in a sterile, culture environment, usually in the laboratory. An example of a sterile culture environment is growth on or in a nutrient medium in a Petri dish, culture flask or test tube. Microbes may be intentionally added to the culture environment, such as in co-culture with Agrobacterium.</rdfs:comment>
        <rdfs:label>in vitro plant structure</rdfs:label>
    </owl:Class>
