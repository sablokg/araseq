    <!-- http://purl.obolibrary.org/obo/PO_0004521 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025407"/>
        <obo:IAO_0000115>A plant fiber cell (PO:0025407) with thin transverse walls (septa), which are formed when mitosis occurs within the cell after development of a secondary cell wall (GO:0009531).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:443</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fibra septada (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>septate fiber (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>隔壁繊維細胞  (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0004521</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <rdfs:comment>A septate fiber septum is composed of the adjacent primary cell walls of two internal cells that arise from mitosis within the septate fiber cell after it has formed a secondary cell wall (GO:0009531).</rdfs:comment>
        <rdfs:label>septate fiber cell</rdfs:label>
    </owl:Class>
