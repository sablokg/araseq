                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025327"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A petal (PO:0009032) that is one of the two lowest petals of a papilionaceous corolla (PO:0025324).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-09-15T02:05:30Z</oboInOwl:creation_date>
