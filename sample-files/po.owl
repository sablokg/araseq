        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025445"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0004516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A secondary xylem tracheary element (PO:0025445) that is part of a portion of late wood (PO:0004516).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-03-14T11:05:40Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:451</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>elemento de tr&amp;#225quea de madera temprana (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>latewood tracheary element (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>晩材管状要素 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025462</oboInOwl:id>
        <rdfs:comment>Late wood tracheary elements generally have smaller cell lumens than early wood tracheary elements (PO:0025461) of the same growth ring (PO:0004514).</rdfs:comment>
        <rdfs:label>late wood tracheary element</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025462"/>
