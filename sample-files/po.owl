    <!-- http://purl.obolibrary.org/obo/PO_0004518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
