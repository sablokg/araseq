    <!-- http://purl.obolibrary.org/obo/PO_0006077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0006077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0006075"/>
        <obo:IAO_0000115>A portion of primary phloem (PO:0006075) tissue has as parts the first-formed sieve elements (PO:0025406) at a particular location and does not have companion cells (PO:0000071, in angiosperms) or albuminous cells (PO:0025412, in gymnosperms) associated with the sieve elements.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:433</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>portion of protophloem tissue (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>protofloema (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>原生師部 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0006077</oboInOwl:id>
        <rdfs:comment>Protophloem is the first primary phloem to develop in any particular location in a portion of vascular tissue (PO:0009015). Sieve elements in the protophloem are smaller than in the metaphloem (PO:0006076). The protophloem usually only lasts a short time before it is replaced by metaphloem.</rdfs:comment>
        <rdfs:label>protophloem</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0006077"/>
