    <!-- http://purl.obolibrary.org/obo/PO_0025570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0001050"/>
        <obo:IAO_0000115>A leaf development stage (PO:0001050) that occurs during the interval between the onset of the vascular leaf initiation stage (PO:0001051) and the termination of the vascular leaf senescent stage (PO:0001054).</obo:IAO_0000115>
        <oboInOwl:created_by>brianatkinson</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-09-06T09:57:58Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:555</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025570</oboInOwl:id>
        <rdfs:comment>In some plants, the leaf developmental stages may occur in the same leaf simultaneously.  For example, leaves maize (or other grasses) have various zones where stages are occurring along the length of the lamina.</rdfs:comment>
        <rdfs:label>vascular leaf development stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025570"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A leaf development stage (PO:0001050) that occurs during the interval between the onset of the vascular leaf initiation stage (PO:0001051) and the termination of the vascular leaf senescent stage (PO:0001054).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Brian_Atkinson</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:Laurel_Cooper</oboInOwl:hasDbXref>
    </owl:Axiom>
    


