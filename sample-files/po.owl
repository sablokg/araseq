    <!-- http://purl.obolibrary.org/obo/PO_0030101 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0030100"/>
        <obo:IAO_0000115>A legume fruit (PO:0030100) which at maturity separates into indehiscent, one-seeded segments.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>indehiscent fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>PO_GIT:645</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>gliederhülse (exact, German)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>loment (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lomento (exact, Spanish)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lomentum (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030101</oboInOwl:id>
        <rdfs:comment>The pericarp (PO:0009084) of some legume fruit (PO:0030100), such as peanuts, is constricted between each seed, but these constrictions are due to a lack of support of the pericarp (PO:0009084) in the space between the seeds (PO:0009010). Contrastingly, the constrictions in the pericarp of loment fruits (PO:0030101) are sclerified and contain regions where cell death leads to disarticulation of the fruit (PO:0009001). Examples: some members of Fabaceae, including Mimosa and Desmodium spp.</rdfs:comment>
        <rdfs:label>loment fruit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0030101"/>
