        <oboInOwl:hasDbXref>ISBN:0471738433</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:Laura_Moore</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025575"/>
