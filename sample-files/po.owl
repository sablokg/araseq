    <!-- http://purl.obolibrary.org/obo/PO_0005599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0005599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0005597"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0005046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cambium (PO:0005597) that is part of a periderm (PO:0005046) and produces phellem (PO:0004003) and phelloderm (PO:0005050).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:437</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:445</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cambium de corcho (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>phellogen (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>コルク形成層 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0005599</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>Cork cambium is located between the phellem and phelloderm and produces phellem toward the outside and phelloderm toward the inside of a plant axis (PO:0025004).</rdfs:comment>
        <rdfs:label>cork cambium</rdfs:label>
    </owl:Class>
