        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0004517</oboInOwl:id>
        <rdfs:comment>Used to describe the boundary area between two adjacent growth rings, which may be distinct or indistinct.</rdfs:comment>
        <rdfs:label>growth ring boundary</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0004517"/>
