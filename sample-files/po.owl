    <!-- http://purl.obolibrary.org/obo/PO_0004700 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004700">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025059"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
