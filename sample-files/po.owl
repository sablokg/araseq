                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A dehiscence zone (PO:0025092) that is part of a fruit.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>zona de dehiscencia del fruto (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>裂開果帯 (Japanese, exact)</oboInOwl:hasExactSynonym>
