        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0006220</oboInOwl:id>
        <rdfs:comment>Also called starchy endosperm region (characteristic of some grasses).</rdfs:comment>
        <rdfs:label>central endosperm</rdfs:label>
    </owl:Class>
