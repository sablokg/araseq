        <oboInOwl:hasRelatedSynonym>one cell stage (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>zygote in Arabidopsis (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0001097</oboInOwl:id>
        <rdfs:comment>Precedes the sporophyte vegetative stage (PO:0007134). Refers to the GO biological process term fertilization (GO:0009566).</rdfs:comment>
        <rdfs:label>plant zygote stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sporophyte development stage (PO:0007134) that occurs during the interval between fertilization and the first cell division of the plant zygote (PO:0000423).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
