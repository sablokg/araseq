        <obo:IAO_0000115>A portion of phloem (PO:0005417) tissue that develops from the procambium (PO:0025275).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:433</oboInOwl:hasDbXref>
