                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0006006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of ground tissue (PO:0025059) that is part of an anther wall (PO:0000002) and develops from an anther wall primary parietal cell layer (PO:0006006).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:359</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>capa secundaria de c&amp;#233lulas parietales (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pollen sac secondary parietal cell layer (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>葯壁二次側膜細胞層、壁細胞層 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0006007</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Angiosperm"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>In many angiosperms, the cells of the anther wall primary parietal cell layer undergo a periclinal division, resulting in the formation of two anther wall secondary parietal layers.</rdfs:comment>
        <rdfs:label>anther wall secondary parietal cell layer</rdfs:label>
    </owl:Class>
