    <!-- http://purl.obolibrary.org/obo/PO_0025459 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000071"/>
        <obo:IAO_0000115>A companion cell (PO:0000400) that lacks cell wall invaginations and has few or no plasmodesmata connecting it to adjacent mesophyll cells.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-03-12T03:06:09Z</oboInOwl:creation_date>
