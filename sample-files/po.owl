    <!-- http://purl.obolibrary.org/obo/PO_0009059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009058"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A collective phyllome structure (PO:0025023) that is composed of one or more petals (PO:0009032), comprising the inner whorl of non-reproductive floral organs (PO:0025395) and surrounds the androecium (PO:0009061) and the gynoecium (PO:0009062).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:71</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:98</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>corola (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>corollae (exact, plural)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>corollas (exact, plural)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>花冠 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0009059</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>The corolla (PO:0009059) is part of the perianth (PO:0009058). This  definition is based on the complete flower, which has all four whorls. In many species, and in mutants one or more of the whorls may be missing. The corolla (PO:0009059) often functions to attract pollinators.</rdfs:comment>
        <rdfs:label>corolla</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0009059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collective phyllome structure (PO:0025023) that is composed of one or more petals (PO:0009032), comprising the inner whorl of non-reproductive floral organs (PO:0025395) and surrounds the androecium (PO:0009061) and the gynoecium (PO:0009062).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Laurel_Cooper</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
