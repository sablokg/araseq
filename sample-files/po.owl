    <!-- http://purl.obolibrary.org/obo/PO_0006346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0006346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0006073"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An intercalary meristem (PO:0006073) that is part of a leaf (PO:0006346) and is intercalated between two portions of non-meristematic tissue between a leaf apex (PO:0020137) and a leaf base (PO:0020040).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:449</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>meristema intercalar de la hoja (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>葉 介在 分裂組織 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0006346</oboInOwl:id>
        <rdfs:comment>Results in an increase in length of a leaf, as part of primary growth. If you are annotating to this term, please add an additional annotation to vascular leaf (PO:0009025) or non-vascular leaf (PO:0025075), depending on the species. All annotations for angiosperms, gymnosperms, and pteridophytes should go to vascular leaf and all annotations for bryophytes should go to non-vascular leaf. The leaf intercalary meristem does not include a leaf plate meristem (PO:0025429) .</rdfs:comment>
        <rdfs:label>leaf intercalary meristem</rdfs:label>
    </owl:Class>
