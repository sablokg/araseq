    <!-- http://purl.obolibrary.org/obo/PO_0025340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0028003"/>
        <obo:IAO_0000115>A gametophyte development stage (PO:0028003) that occurs during the interval between spore germination and the formation of a gametangium.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-10-19T11:55:08Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:395</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>etapa vegetativa del gemetofito (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>配偶体栄養期 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025340</oboInOwl:id>
        <rdfs:comment>A gametophyte may begin to senesce or die from other causes before producing gametangia. Some plants, such as the fern Vittaria appalachiana, may never produce gametangia, and remain in the vegetative stage indefinitely. Developmental vegetative growth (GO:0080186) can also occur during the reproductive stage.</rdfs:comment>
        <rdfs:label>gametophyte vegetative stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025340"/>
