        <oboInOwl:hasExactSynonym>隔離層 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0006211</oboInOwl:id>
        <rdfs:comment>Directly involved in the weakening process of abscission.</rdfs:comment>
        <rdfs:label>separation layer</rdfs:label>
    </owl:Class>
