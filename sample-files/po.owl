    <!-- http://purl.obolibrary.org/obo/PO_0001012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0001012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0001007"/>
        <obo:IAO_0000115>Stage of microgametophyte development during which the microspores round up and small vacuoles appear in their cytoplasm. The microspore walls thicken due to the formation of the exine.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GRO:0007226</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:509</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
