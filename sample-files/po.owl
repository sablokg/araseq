        </rdfs:subClassOf>
        <obo:IAO_0000115>A cardinal organ part (PO:0025001) that is part of a plant axis (PO:0025004) and has as parts a cambium (PO:0005597) and adjacent cells.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-03-01T10:34:20Z</oboInOwl:creation_date>
