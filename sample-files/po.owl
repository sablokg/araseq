    <!-- http://purl.obolibrary.org/obo/PO_0005360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0005360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009089"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of plant tissue (PO:0009007) that is the outermost layer of endosperm (PO:0009089) in a seed (PO:0009010), its cells being characterized by presence of protein bodies (GO:0042735).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PO:0008004</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>PO_GIT:149</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:285</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:286</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:49</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>capa de aleurona (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fruit aleurone layer (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>糊粉粒、アリューロン層 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0005360</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Angiosperm"/>
        <rdfs:comment>Occurs in cereals and many other taxa. The protein bodies (GO:0042735) contain seed storage proteins and enzymes involved with endosperm digestion (Esau, 1977).</rdfs:comment>
        <rdfs:label>aleurone layer</rdfs:label>
    </owl:Class>
