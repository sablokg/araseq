    <!-- http://purl.obolibrary.org/obo/PO_0005849 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0005849">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0005352"/>
