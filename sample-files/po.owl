        <oboInOwl:hasRelatedSynonym>06-inflorescence emergence in barley (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>06-inflorescence emergence in oat (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>06-inflorescence emergence in wheat (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>08-heading in sorghum (related)</oboInOwl:hasRelatedSynonym>
