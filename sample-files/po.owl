        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0000078</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <rdfs:comment>Appear to be specialized for short-distance transfer of solutes. Transfer cells can occur anywhere there is a junction between two individuals, such as between a sporophyte and a gametophyte, or between a parasitic plant and its host.</rdfs:comment>
        <rdfs:label>transfer cell</rdfs:label>
    </owl:Class>
