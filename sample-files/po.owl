            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A root epidermal cell (PO:0025164) that develops from a trichoblast (PO:0000262) and has as part a root hair (GO:0035618).</obo:IAO_0000115>
