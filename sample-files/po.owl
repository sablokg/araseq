    <!-- http://purl.obolibrary.org/obo/PO_0025580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009058"/>
        <obo:IAO_0000115>A perianth (PO:0009058) in which one or more of the petals (PO:0009032), sepals (PO:0009031), and/or tepals (PO:0009033) are fused (PATO:0000642).</obo:IAO_0000115>
        <oboInOwl:created_by>brianatkinson</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-06-25T14:09:14Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:549</oboInOwl:hasDbXref>
