        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000077"/>
        <obo:IAO_0000115>A sclerenchyma cell (PO:0000077) with many pits in the secondary cell wall.</obo:IAO_0000115>
