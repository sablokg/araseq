        <obo:IAO_0000115>A microsporangium wall (PO:0025307) that is part of an anther (PO:0009066).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PO:0006445</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>PO:0006477</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>PO_GIT:149</oboInOwl:hasDbXref>
