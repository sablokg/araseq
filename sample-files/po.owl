        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A microsporangium that is part of a sporophyll and where the pollen grains develop and are located after they develop.</obo:IAO_0000115>
