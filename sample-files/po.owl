            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A collective phyllome structure composed of two or more involucral bracts at the base of a cluster of flowers, as found in Asteraceae or Compositae.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:71</oboInOwl:hasDbXref>
