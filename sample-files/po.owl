    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025328"/>
        <obo:IAO_0000115>A unifacial leaf that is round in cross section throughout all of part of the length of the leaf.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-09-28T04:08:06Z</oboInOwl:creation_date>
