    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0007026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0007016"/>
        <obo:IAO_0000115>The stage at which the first flower(s) open.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GRO:0007102</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SGN:0000035</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SOY:0000072</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAIR:0000421</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>6.00 1st flowers on main stem open in soybean (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>7.01-anthesis beginning in Triticeae (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>7.01-anthesis beginning in barley (related)</oboInOwl:hasRelatedSynonym>
