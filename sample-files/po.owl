    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
