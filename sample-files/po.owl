    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0006221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0005006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A laticifer cell (PO:0025031) that is joined longitudinally to other articulated laticifer cells to form a tube.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:129</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>c&amp;#233lula del latic&amp;#237fero articulado (Spanish, exact)</oboInOwl:hasExactSynonym>
