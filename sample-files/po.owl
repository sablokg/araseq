    <!-- http://purl.obolibrary.org/obo/PO_0030057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025606"/>
        <rdfs:subClassOf>
            <owl:Restriction>
