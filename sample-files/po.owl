        <owl:annotatedTarget>&amp;#225pice en zarzillo del tallo (Spanish, exact)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Maria_Alejandra_Gandolfo</oboInOwl:hasDbXref>
