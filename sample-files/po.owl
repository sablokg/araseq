    <!-- http://purl.obolibrary.org/obo/PO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0003023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000042"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Enlargement or swelling at position of dormant adventitious root primordium (on the stem), inhabited by nitrogen-fixing bacteria.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:235</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>n&amp;#243dulo de la ra&amp;#237z adventicia (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>不定根根粒 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>stem primordium (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0000040</oboInOwl:id>
        <rdfs:comment>Unlike the root nodules, these contain functioning chloroplasts in the nodule cortex and are therefore capable of carbon fixation. Note: stem nodule is commonly used term for this structure, although the nodules are formed at positions of dormant adventitious root primordia.</rdfs:comment>
        <rdfs:label>adventitious root nodule</rdfs:label>
    </owl:Class>
