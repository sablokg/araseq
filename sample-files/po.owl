    <!-- http://purl.obolibrary.org/obo/PO_0006067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0006067">
        <obo:IAO_0000115>OBSOLETE. A cup-shaped region in the shoot apical meristem found between the central mother cell and the rib and peripheral zone. The cells of this zone are derived from the corpus intials, but in some cases they arise also from tunica initials.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>zona transicional semejante al cambium (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>形成層様移行帯 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>adaxial meristem (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>leaf meristem (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral meristem (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0006067</oboInOwl:id>
        <rdfs:comment>If found, this zone is a temporary feature mostly in Gymnosperms.</rdfs:comment>
        <rdfs:label>OBSOLETE cambium-like transitional zone</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
