        <obo:IAO_0000115>A bract (PO:0009055) that subtends an archegonium (PO:0025126).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-04-12T10:07:51Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:290</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>br&amp;#225ctea pericaetal (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>perichaetum bract (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>雌花苞葉 (Japanese, exact)</oboInOwl:hasExactSynonym>
