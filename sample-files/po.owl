        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>There is no differentiation between the petals (PO:0009032) and the sepals (PO:0009031) in color, placement, and size (e.g. some species of Magnolia).</rdfs:comment>
        <rdfs:label>tepal</rdfs:label>
