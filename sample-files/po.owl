        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025334</oboInOwl:id>
        <rdfs:comment>The surface of a terete leaf corresponds to either the adaxial or abaxial surface of a normal leaf.</rdfs:comment>
        <rdfs:label>terete vascular leaf</rdfs:label>
