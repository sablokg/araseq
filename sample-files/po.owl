    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009025"/>
        <obo:IAO_0000115>A vascular leaf that is slender and coiling and lacks a lamina.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-11-16T05:02:31Z</oboInOwl:creation_date>
