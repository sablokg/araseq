    <!-- http://purl.obolibrary.org/obo/PO_0025299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025299">
        <obo:IAO_0000115>OBSOLETE. A fused perianth that is composed of fused sepals or petals and located on top of a gynoecium that contains an inferior ovary.</obo:IAO_0000115>
        <oboInOwl:consider>PO:0025329</oboInOwl:consider>
        <oboInOwl:consider>PO:0025330</oboInOwl:consider>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-04-26T08:45:55Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:312</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>angiosperm calyptra (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>caliptra del perianto (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>floral calyptra (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>floral operculum (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>flower calyptra (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>flower operculum (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>蘚帽花蓋、花被  (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025299</oboInOwl:id>
        <rdfs:comment>Found in Eucalyptus and other Myrtaceae. This term was made obsolete and replaced by the more specific terms calyptra calyx (PO:0025329) and calyptra corolla (PO:0025330).</rdfs:comment>
        <rdfs:label>OBSOLETE calyptra perianth</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
