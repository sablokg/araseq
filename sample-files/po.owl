    <!-- http://purl.obolibrary.org/obo/PO_0005025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0005025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0005426"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0005022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of chlorenchyma tissue (PO:0005426) that is part of the plant ovary wall (PO:0005022) and is composed of mesophyll cells (PO:0004006).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:280</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:49</oboInOwl:hasDbXref>
