        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A meristematic cell (PO:0004010) that by division gives rise to two cells, one of which remains meristematic, while the other is added to the plant body.</owl:annotatedTarget>
