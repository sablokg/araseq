    <!-- http://purl.obolibrary.org/obo/PO_0004542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
        <obo:IAO_0000115>A swollen shoot axis (PO:0025029) that grows horizontally at or below the substrate surface and produces shoots above and roots or rhizoids below.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FNA:7a04b02c-8ac5-410a-99cd-b68ba80e8f14</oboInOwl:hasDbXref>
