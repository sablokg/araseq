    <!-- http://purl.obolibrary.org/obo/PO_0020122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0020122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A shoot axis (PO:0025029) that is part of an inflorescence (PO:0009049).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:260</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:667</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>eje de la inflorescencia (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>first order inflorescence branch (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>inflorescence rachis (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>花序軸 (Japanese, related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0020122</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Angiosperm"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>An inflorescence axis (PO:0020122) has either a determinate apex, which terminates in a flower meristem (PO:0000229), or has an indeterminate apex, which terminates in an inflorescence apical meristem (PO:0009108).  An inflorescence pedicel (PO:0009052) is the simplest example of a determinate inflorescence axis.</rdfs:comment>
        <rdfs:label>inflorescence axis</rdfs:label>
    </owl:Class>
