    <!-- http://purl.obolibrary.org/obo/PO_0025354 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
        <obo:IAO_0000115>A shoot axis that is flattened and expanded.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-11-16T03:12:07Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:398</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cladodio (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cladophyll (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>phylloclade (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>扁茎、仮葉枝、葉状茎 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025354</oboInOwl:id>
        <rdfs:comment>Has an increased surface area for photosynthesis and may function similar to leaves in plants that have no or small leaves, such as cacti. Consists of one to several internodes and nodes. Cladodes bear scale leaves (or leaf scars where temporary leaves have fallen off) that subtend axillary buds.</rdfs:comment>
        <rdfs:label>cladode</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025354"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A shoot axis that is flattened and expanded.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:9780881928501</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025354"/>
