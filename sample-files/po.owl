    <!-- http://purl.obolibrary.org/obo/PO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025269"/>
        <obo:IAO_0000115>A collective organ part structure composed of two or more layers of various tissues that is a partition that divides a cavity formed by the fusion of two or more organs.</obo:IAO_0000115>
