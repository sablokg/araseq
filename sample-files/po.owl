        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0000289"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>miembro del tubo criboso (Spanish, exact)</owl:annotatedTarget>
