        <obo:IAO_0000115>A cardinal organ part that is the basal (distal) part of a sporangium.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-04-12T11:57:20Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>ISBN:0962073342</oboInOwl:hasDbXref>
