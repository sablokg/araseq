            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/PO_0008030"/>
        <obo:IAO_0000115>A shoot epidermal cell (PO:0025165) that is relatively unspecialized at maturity.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:256</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>c&amp;#233lula del pavimento epidermal (Spanish, exact)</oboInOwl:hasExactSynonym>
