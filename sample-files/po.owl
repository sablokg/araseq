    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <obo:IAO_0000115>A portion of plant tissue (PO:0009007) that has as parts hydroid (PO:0025032) cells and cells of no other types.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-04-18T09:34:43Z</oboInOwl:creation_date>
