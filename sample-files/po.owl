    <!-- http://purl.obolibrary.org/obo/PO_0025412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000074"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0005417"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002220"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A parenchyma cell (PO:0000074) that is morphologically and physiologically associated with a sieve cell (PO:0025415) but does is not derived from the same initial cell (PO:0004011) as the sieve cell.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-02-01T11:50:29Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:442</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>c&amp;#233lula albuminosa (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>有胚乳細胞 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025412</oboInOwl:id>
        <rdfs:comment>May be found in the ray system (PO:0025411) and sometimes the axial system (PO:0025410) of gymnosperms. Compare to companion cells (PO:0000071), which are found in angiosperms.</rdfs:comment>
        <rdfs:label>albuminous cell</rdfs:label>
    </owl:Class>
