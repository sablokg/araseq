        <oboInOwl:hasExactSynonym>hydrom (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leptoxylem (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>導水組織 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030047</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Bryophytes"/>
        <rdfs:comment>A hydrome is composed of only hydroids. Found in bryophytes, in the center of a non-vascular shoot axis (PO:0025029) such as a gametophore (PO:0030018) or seta (PO:0030032). Often surrounded by the leptome (PO:0030048). May function in water conduction and may provide support.</rdfs:comment>
        <rdfs:label>hydrome</rdfs:label>
