    <!-- http://purl.obolibrary.org/obo/PO_0000044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0003005"/>
        <obo:IAO_0000115>A shoot-borne nodal root (PO:0003005) formed at a stem node (PO:0020141) above the ground and growing directly into the soil.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>breathing root (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>PO_GIT:163</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ra&amp;#237z de sost&amp;#233n (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>支柱根、支持根、支柱気根 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>brace root (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0000044</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Maize"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>This term is perhaps best defined functionally to prop the plant up, but sometimes prop roots may also act as breathing roots. Compare to pneumatophore (PO:0025357), which is a lateral root that grows upwards from below the soil or water surface.</rdfs:comment>
        <rdfs:label>prop root</rdfs:label>
    </owl:Class>
