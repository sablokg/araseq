    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025261"/>
        <obo:IAO_0000115>A pericycle cell that is adjacent to the protophloem of a vascular bundle.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-02-02T11:55:06Z</oboInOwl:creation_date>
