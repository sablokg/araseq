        <obo:IAO_0000115>A primary xylem tracheary element (PO:0025444) that may have helical, scalariform, reticulate and/or pitted secondary wall thickening.</obo:IAO_0000115>
        <oboInOwl:created_by>moorel</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-06-10T11:48:17Z</oboInOwl:creation_date>
