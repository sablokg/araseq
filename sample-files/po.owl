                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A gametophyte development stage (PO:0028003) that occurs during the interval between meiosis and the germination of a spore.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-01-05T10:32:33Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>spore stage (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>PO_GIT:425</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>etapa esporof&amp;#237tica de la planta (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>胞子期 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025375</oboInOwl:id>
        <rdfs:comment>Includes the stage when a megaspore is present before it develops into a megagametophyte or embryo sac and the stage when a microspore is present before it develops into a microgametophyte or pollen. There may be cell division in a spore before it germinates.</rdfs:comment>
        <rdfs:label>plant spore stage</rdfs:label>
    </owl:Class>
