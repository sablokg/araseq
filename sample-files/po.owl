    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009009"/>
        <obo:IAO_0000115>A plant embryo (PO:0009009) that arises from previously differentiated somatic cells, rather than from fused gametes, i.e. the plant zygote (PO:0000423).</obo:IAO_0000115>
        <oboInOwl:created_by>Laurel_Cooper</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-04-27T11:46:50Z</oboInOwl:creation_date>
