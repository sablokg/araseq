    <!-- http://purl.obolibrary.org/obo/PO_0001003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0001003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0001051"/>
        <obo:IAO_0000115>A vascular leaf initiation stage (PO:0007040) during which the vascular leaf founder cells (PO:0025592) of the shoot apical meristem (PO:0020148) form a vascular leaf anlagen (PO:0025431).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GRO:0007161</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:560</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:573</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vascular leaf founder cell formation stage (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>P0 stage (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>leaf stage P0 (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0001003</oboInOwl:id>
        <rdfs:comment>The initial stage of leaf development when cells in the shoot apical meristem (PO:0020148) are already determined to form a vascular leaf primordium (PO:0000017), but the primordium is not yet morphologically distinguishable.</rdfs:comment>
        <rdfs:label>vascular leaf anlagen formation stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0001003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A vascular leaf initiation stage (PO:0007040) during which the vascular leaf founder cells (PO:0025592) of the shoot apical meristem (PO:0020148) form a vascular leaf anlagen (PO:0025431).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Brian_Atkinson</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:Laurel_Cooper</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAIR_curator:Katica_Ilic</oboInOwl:hasDbXref>
    </owl:Axiom>
