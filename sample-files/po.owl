        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>A vascular cambium produces cells in both directions, centrifugally and centrifically, leading to an increase in the cross-sectional area of a plant axis (PO:0025004).</rdfs:comment>
        <rdfs:label>vascular cambium</rdfs:label>
    </owl:Class>
