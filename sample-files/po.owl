                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0007057"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A root development stage (PO:0007520) during which a radicle (PO:0020031) emerges from the seed coat (PO:0009088).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PO:0007507</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GRO:0007005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GRO:0007055</oboInOwl:hasDbXref>
