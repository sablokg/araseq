    <!-- http://purl.obolibrary.org/obo/PO_0005046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0005046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025059"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A peripheral portion of ground tissue (PO:0025059) in a plant axis (PO:0025004) that is composed of cork cambium (phellogen; PO:0005599), phellem (PO:0004003), and phelloderm (PO:0005050).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:110</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>peridermis (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>portion of periderm tissue (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>portion of peridermal tissue (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>周皮 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0005046</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>After secondary growth, the periderm may replace the epidermis in stems and roots, rarely in other organs. In some cases, the epidermis is retained after periderm development. Periderm is derived from lateral meristem and may contain secondary phloem.</rdfs:comment>
        <rdfs:label>periderm</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0005046"/>
