    <!-- http://purl.obolibrary.org/obo/PO_0030119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
        <obo:IAO_0000115>An inflorescence (PO:0009049) with a monopodial growth habit, which at flowering stage (PO:0007616) is composed of indeterminate, first order inflorescence axes (PO:0025104) and sessile, unisexual flowers (PO:0009046) that are each subtended by conspicuous inflorescence bracts (PO:0009054).</obo:IAO_0000115>
        <oboInOwl:created_by>NYBG:Brandon_Sinn</oboInOwl:created_by>
        <oboInOwl:creation_date>2017-04-20T12:48:27Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>ament (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>catkin (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030119</oboInOwl:id>
        <rdfs:comment>Examples include poplars (including Populus trichocarpa, Salicaceae) and birches (Betula spp., Betulaceae). Catkin inflorescences are often pendulate.</rdfs:comment>
        <rdfs:label>catkin inflorescence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0030119"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An inflorescence (PO:0009049) with a monopodial growth habit, which at flowering stage (PO:0007616) is composed of indeterminate, first order inflorescence axes (PO:0025104) and sessile, unisexual flowers (PO:0009046) that are each subtended by conspicuous inflorescence bracts (PO:0009054).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NYBG:Brandon_Sinn</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NYBG:Dario_Cavaliere</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO:cooperl</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PO_0030120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
        <obo:IAO_0000115>An inflorescence (PO:0009049) with a monopodial growth habit, which at flowering stage (PO:0007616), is composed of sessile flowers (PO:0009046) on a radially-enlarged, indeterminate, first order inflorescence axis (PO:0025104), and a basal, enveloping inflorescence bract (PO:0009054).</obo:IAO_0000115>
        <oboInOwl:created_by>NYBG:Brandon_Sinn</oboInOwl:created_by>
        <oboInOwl:creation_date>2017-04-20T12:50:40Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>spadices (exact, plural)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spadix (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030120</oboInOwl:id>
        <rdfs:comment>Examples include aroids (Araceae), palms (Arecaceae).</rdfs:comment>
        <rdfs:label>spadix inflorescence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0030120"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An inflorescence (PO:0009049) with a monopodial growth habit, which at flowering stage (PO:0007616), is composed of sessile flowers (PO:0009046) on a radially-enlarged, indeterminate, first order inflorescence axis (PO:0025104), and a basal, enveloping inflorescence bract (PO:0009054).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NYBG:Brandon_Sinn</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NYBG:Dario_Cavaliere</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO:cooperl</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
