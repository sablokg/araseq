        <oboInOwl:hasBroadSynonym>midrib (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>PO_GIT:352</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>costa (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>costae (exact, plural)</oboInOwl:hasExactSynonym>
