            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of plant tissue (PO:0009007) that is the outer layer (wall) of a fruit (PO:0009001), and develops from a plant ovary (PO:0009072) or a carpel (PO:0009030) wall.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:149</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:511</oboInOwl:hasDbXref>
