        <oboInOwl:hasExactSynonym>果皮 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>fruit peel (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fruit rind (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0009084</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Arabidopsis"/>
