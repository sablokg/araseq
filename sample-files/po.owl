    <!-- http://purl.obolibrary.org/obo/PO_0004520 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000274"/>
        <obo:IAO_0000115>A xylem fiber cell (PO:0000274) with simple pits.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:443</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fibra libriforme (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>libriform fiber (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>真性木繊維 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0004520</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <rdfs:comment>Libriform fiber cells have simple (unbordered) pits while fiber tracheids (PO:0000355) have bordered pits. Many intermediate forms exist and are generally classified as fiber tracheids (PO:0000355). If both libriform fiber cells and fiber tracheids are present, the libriform fiber cells usually have thicker walls. Libriform fiber cells have a slit-like aperture toward the cell lumen, but no pit cavity.</rdfs:comment>
        <rdfs:label>libriform fiber cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0004520"/>
