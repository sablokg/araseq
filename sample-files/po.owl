    <!-- http://purl.obolibrary.org/obo/PO_0009007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009011"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/PO_0009008"/>
