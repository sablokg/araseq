        <oboInOwl:hasNarrowSynonym>anthelae (exact, plural)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030125</oboInOwl:id>
        <rdfs:comment>Examples include species of Filipendula (Rosaceae).</rdfs:comment>
