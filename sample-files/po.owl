        <oboInOwl:hasDbXref>PATO:0002227</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:77</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>hipantio (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hypanthia (exact, plural)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>花床筒 、いちじく状花序 i.e.hypanthodium (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0009065</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>Only bears stamens or perianth segments if they are present in the flower (e.g., no stamens in a carpellate flower).</rdfs:comment>
        <rdfs:label>hypanthium</rdfs:label>
    </owl:Class>
