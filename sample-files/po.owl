    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000290"/>
        <obo:IAO_0000115>A tracheary element (PO:0000290) that has no perforations in its cell wall.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:440</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>traqueida (Spanish, exact)</oboInOwl:hasExactSynonym>
