                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cardinal organ part (PO:0025001) at the apex or base of a petiole, petiolule, leaf sheath, or branch that is differentiated from the remaining organ parts by its enlarged cross section.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PATO:0000586</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:70</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:81</oboInOwl:hasDbXref>
