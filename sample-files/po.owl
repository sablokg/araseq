    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025161"/>
        <obo:IAO_0000115>A portion of plant substance (PO:0025161) that consists of a complex mixture of organic aromatic compounds such as mono-, sesqui-, and diterpenoids.</obo:IAO_0000115>
        <oboInOwl:created_by>Laurel_Cooper</oboInOwl:created_by>
        <oboInOwl:creation_date>2014-04-10T09:51:14Z</oboInOwl:creation_date>
