    <!-- http://purl.obolibrary.org/obo/PO_0020121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0020121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A root (PO:0009005) that develops from a lateral root primordium (PO:0000016) that is part of another root on the same plant.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:473</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ra&amp;#237z lateral (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>側根 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0020121</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Angiosperm"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Arabidopsis"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Gymnosperms"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Maize"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Poaceae"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Potato"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Rice"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Tomato"/>
        <rdfs:comment>A lateral root primordium may develops on any root, including a primary root (PO:0020127), on an existing lateral root (PO:0020121), or a shoot-borne root (PO:0000042). In seed plants, a lateral root primordium generally develops from pericycle cells (PO:0025261), but cells of an endodermis (PO:0000252) may also participate in its formation in some species. In ferns, lateral root primordia develop from the endodermis.</rdfs:comment>
        <rdfs:label>lateral root</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0020121"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A root (PO:0009005) that develops from a lateral root primordium (PO:0000016) that is part of another root on the same plant.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0521288959</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISRR:Richard_Zobel</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
