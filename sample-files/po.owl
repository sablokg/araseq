            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An shoot epidermal pavement cell (PO:0000332) that is part of sepal epidermis (PO:0006040) and is approximately one fifth the length of a sepal (PO:0009031).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-10-01T11:39:23Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>giant cell (broad)</oboInOwl:hasBroadSynonym>
