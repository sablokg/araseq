    <!-- http://purl.obolibrary.org/obo/PO_0009012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A stage in the life of a plant structure (PO:0009011) during which the plant structure undergoes developmental processes.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PO:0007021</oboInOwl:hasAlternativeId>
