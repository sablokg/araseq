    <!-- http://purl.obolibrary.org/obo/PO_0025576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025444"/>
