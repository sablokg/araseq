    <!-- http://purl.obolibrary.org/obo/PO_0025341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0028003"/>
        <obo:IAO_0000115>A gametophyte development stage (PO:0028003) that occurs during the interval between the initiation of either a multicellular plant gametangium (PO:0025124) or a unicellular plant gametangium (PO:0025521) and the onset of senescence.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-10-19T11:55:08Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:396</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>etapa reproductiva del gametofito (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gametophyte reproductively competent stage (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gametophytic reproductive stage (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>配偶体生殖段階 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025341</oboInOwl:id>
        <rdfs:comment>A whole plant (PO:0000003) may continue developmental vegetative growth (GO:0080186) after it has entered the reproductive stage, and it may revert to a stage in which it is no longer producing gametantia, but once it has initiated a single gametangium, it remains in the reproductive stage until senescence or death by some other cause.</rdfs:comment>
        <rdfs:label>gametophyte reproductive stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025341"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A gametophyte development stage (PO:0028003) that occurs during the interval between the initiation of either a multicellular plant gametangium (PO:0025124) or a unicellular plant gametangium (PO:0025521) and the onset of senescence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Laurel_Cooper</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025341"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>etapa reproductiva del gametofito (Spanish, exact)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Maria_Alejandra_Gandolfo</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/po#Spanish"/>
    </owl:Axiom>
    <owl:Axiom>
