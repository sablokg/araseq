    <!-- http://purl.obolibrary.org/obo/PO_0030098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
        <obo:IAO_0000115>A fruit (PO:0009001) which develops from a gynoecium (PO:0009062) and at maturity comprises a dry exocarp (PO:0009085), dry mesocarp (PO:0009087), and dry endocarp (PO:0009086) that separate into mericarps (PO:0020075).</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>indehiscent fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>PO_GIT:643</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>doppelnuß (exact, German)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>esquizocarpio (exact, Spanish)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>esquizocarpo (exact, Spanish)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>schizocarp (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spalt-nußfrucht (exact, German)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>pyrine (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030098</oboInOwl:id>
        <rdfs:comment>Each individual carpellate unit of a schizocarp fruit (PO:0030098) is a mericarp (PO:0020075). Example: maple (Acer spp.).</rdfs:comment>
        <rdfs:label>schizocarp fruit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
