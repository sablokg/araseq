    <!-- http://purl.obolibrary.org/obo/PO_0004517 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0005848"/>
        <obo:IAO_0000115>A portion of secondary xylem (PO:0005848) that includes the last-formed late wood (PO:0004516) of one growth ring (PO:0004514) and the earliest-formed early wood (PO:0004515) of the next growth ring.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:453</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>l&amp;#237mite del anillo de crecimiento (Spanish, exact)</oboInOwl:hasExactSynonym>
