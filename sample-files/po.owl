            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A gametophyte development stage (PO:0028003) during which the megagametophyte (PO:0025279) develops.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:589</oboInOwl:hasDbXref>
