        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000282"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0006048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A trichome that develops from seed coat epidermis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>seed hair (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tricoma de la semilla (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>種子毛（毛茸、糸状体、毛状突起体） (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>pubescence (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0004511</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:label>seed trichome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0004511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A trichome that develops from seed coat epidermis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0004511"/>
