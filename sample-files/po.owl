    <!-- http://purl.obolibrary.org/obo/PO_0025367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009042"/>
        <obo:IAO_0000115>A prophyll that is slender and coiling and lacks a lamina.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-11-16T05:09:07Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>tendril (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>profilo en zarzillo (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>前葉巻きひげ、前出葉巻きひげ (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025367</oboInOwl:id>
        <rdfs:comment>Aids plant in climbing. A prophyll may be difficult to distinguish from a branch tendril, because it may be found in the axil of a leaf, but it develops from a prophyll of the axillary bud, rather than a branch. Found in Curburitaceae. See also leaf tendril (PO:0025361), leaflet tendril (PO:0025362), leaf apex tendril (PO:0025363), branch tendril (PO:0025364), stem apex tendril (PO:0025365), and leaf rachis tendril (PO:0025366). Careful observation is required to correctly classify some tendrils.</rdfs:comment>
        <rdfs:label>prophyll tendril</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025367"/>
