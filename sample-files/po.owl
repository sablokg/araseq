        </rdfs:subClassOf>
        <obo:IAO_0000115>A plant anatomical space that is an opening in a hydathode.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-05-11T01:48:37Z</oboInOwl:creation_date>
