        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0005849"/>
        <obo:IAO_0000115>A portion of primary xylem (PO:0005849) tissue that has as part one or more metaxylem tracheary elements (PO:0025576) embedded in parenchyma (PO:0005421) tissue and may contain xylem fiber cells (PO:0000274).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:434</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>metaxilema (Spanish, exact)</oboInOwl:hasExactSynonym>
