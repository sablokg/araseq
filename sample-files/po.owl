        <oboInOwl:hasDbXref>Gramene:Anuradha_Pujar</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PO_0007506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0007506">
