    <!-- http://purl.obolibrary.org/obo/PO_0007007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0007007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0007042"/>
        <obo:IAO_0000115>A whole plant fruit formation stage (PO:0007042) that spans the interval when the average size of fruits (PO:0009001) on a whole plant (PO:0000003) has reached 50% to 70% of its final size.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GRO:0007107</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GRO:0007109</oboInOwl:hasDbXref>
