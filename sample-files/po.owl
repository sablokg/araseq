    <!-- http://purl.obolibrary.org/obo/PO_0000332 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025165"/>
