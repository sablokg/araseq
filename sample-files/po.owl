    <!-- http://purl.obolibrary.org/obo/PO_0030112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
        <obo:IAO_0000115>A shoot axis (PO:0025029) that bears only a flower (PO:0009046) or a fruit (PO:0009001).</obo:IAO_0000115>
        <oboInOwl:created_by>NYBG:Brandon_Sinn</oboInOwl:created_by>
        <oboInOwl:creation_date>2017-03-17T00:43:36Z</oboInOwl:creation_date>
