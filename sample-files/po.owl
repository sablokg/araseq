    <!-- http://purl.obolibrary.org/obo/PO_0025379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025117"/>
        <rdfs:subClassOf>
