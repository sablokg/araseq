        <obo:IAO_0000115>A pericycle cell that is adjacent to the protoxylem of a vascular bundle.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-02-02T11:52:34Z</oboInOwl:creation_date>
