        <oboInOwl:hasRelatedSynonym>FL.00 first flower(s) open in Solanaceae (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stage R1 Open flower at any node on the main stem (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>first open flower in Arabidopsis (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0007026</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Angiosperm"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Arabidopsis"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Citrus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Maize"/>
