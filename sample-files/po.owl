    <!-- http://purl.obolibrary.org/obo/PO_0020090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0020090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025026"/>
        <obo:IAO_0000115>An embryo sac cell (PO:0025026) that is largest cell in a mature embryo sac (PO:0025074).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:182</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>c&amp;#233lula central (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>中央細胞 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0020090</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>In most angiosperms, the embryo sac central cell contains two polar nuclei, and, after double fertilization, develops into an endosperm. In some angiosperms, such as Illicium, the embryo sac central cell contains a single polar nucleus. Embryo sac central cell is distinct from archegonium central cell (PO:0025509).</rdfs:comment>
        <rdfs:label>embryo sac central cell</rdfs:label>
    </owl:Class>
