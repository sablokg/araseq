    <!-- http://purl.obolibrary.org/obo/PO_0030001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000076"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0030004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A chlorenchyma cell that is part of a chloronema and has cross walls of adjacent cells that are perpendicular to the protonema axis.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-03-10T10:51:12Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:300</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>c&amp;#233lula del cloronema (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>クロロネマ細胞 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030001</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Bryophytes"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <rdfs:comment>A chloronema cell contains many well-developed chloroplasts.</rdfs:comment>
        <rdfs:label>chloronema cell</rdfs:label>
    </owl:Class>
