        <oboInOwl:hasDbXref>MaizeGDB:67351</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:386</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SGN:0000006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SOY:0000011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAIR:T0000395</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>0.02-radicle emergence from seed in maize (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>0.2 radicle emergence from seed in maize (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>05 radicle emergence from seed coat in soybean (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1.04-radicle emerged from seed in Triticeae (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1.04-radicle emerged from seed in barley (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1.04-radicle emerged from seed in oat (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1.04-radicle emerged from seed in wheat (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BBCH growth stage 05 (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Zadok scale-5 (related)</oboInOwl:hasRelatedSynonym>
