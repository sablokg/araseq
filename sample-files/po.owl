            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of plant substance (PO:0025161) that is the inner layer of a plant cuticle (PO:0000022), and is composed of a polyester matrix of hydroxy- and hydroxy epoxy fatty acid C16 and C18 chains.</obo:IAO_0000115>
        <oboInOwl:created_by>Laurel_Cooper</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-01-06T02:53:37Z</oboInOwl:creation_date>
