        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <rdfs:comment>Xylem pole pericycle cells are cells in the pericycle that are adjacent to the protoxylem pole of a vascular bundle. Pericycle cells that are adjacent to other xylem cells in the vascular bundle are not considered xylem pole pericycle cells. Xylem pole pericycle cells may retain some meristematic activity and are the site of lateral root initiation.</rdfs:comment>
        <rdfs:label>xylem pole pericycle cell</rdfs:label>
    </owl:Class>
