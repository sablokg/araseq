    <!-- http://purl.obolibrary.org/obo/PO_0009015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <obo:IAO_0000115>A portion of plant tissue (PO:0009007) that has as part one or more tracheary elements (PO:0000290) or sieve elements (PO:0025406).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001432</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:431</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>porci&amp;#243n de tejido vascular (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vascular tissue (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>維管束細胞の一部 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>vascular system (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0009015</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>Functions in conduction and support. In shoot axes (PO:0025029), vascular tissue is often found as part of a shoot axis stele (PO:0025198) or as scattered vascular bundles (PO:0005020). May include other types of tissues or cells, such as parenchyma (PO:0005421) or fiber cells (PO:0025407).</rdfs:comment>
        <rdfs:label>portion of vascular tissue</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0009015"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
