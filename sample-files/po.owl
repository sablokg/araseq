    <!-- http://purl.obolibrary.org/obo/PO_0025405 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025404"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
