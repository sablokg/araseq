    <!-- http://purl.obolibrary.org/obo/PO_0006003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0006003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0006001"/>
        <obo:IAO_0000115>A phyllome that is reduced in size relative to a vascular leaf on the same plant and is often associated with a perennating or dormant bud or a vegetatively propagating organ such as a rhizome.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:273</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cat&amp;#225fila en escama (Spanish, exact)</oboInOwl:hasExactSynonym>
