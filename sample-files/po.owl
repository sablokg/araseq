    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025030"/>
        <obo:IAO_0000115>A cell with wall ingrowths (or invaginations) that increase the surface of the plasmalemma.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:275</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>c&amp;#233lula de transferencia (Spanish, exact)</oboInOwl:hasExactSynonym>
