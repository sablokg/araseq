    <!-- http://purl.obolibrary.org/obo/PO_0025413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0020138"/>
        <obo:IAO_0000115>A leaf lamina vein (PO:0020138) that connects directly to a petiole vascular system (PO:0000052) or a shoot axis vascular system (PO:0000039).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-02-01T04:24:58Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:435</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vena primaria de la hoja (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>一次葉脈 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025413</oboInOwl:id>
        <rdfs:comment>Generally the largest and most prominent of the leaf veins. A leaf may have more than one primary vein. The central primary vein is the midvein (PO:0020139). Vein orders only apply to hierarchically branching vein patterns, not to dichotomously branching vein patterns, as found in some ferns and gymnosperms.</rdfs:comment>
        <rdfs:label>primary leaf vein</rdfs:label>
    </owl:Class>
