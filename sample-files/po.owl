        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0020145"/>
        <obo:IAO_0000115>A lateral meristem (PO:0020145) that has as part a single layer of cambial initial cells (PO:0000295) and their derivatives, arranged orderly in radial files.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:437</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cambium (Spanish, exact)</oboInOwl:hasExactSynonym>
