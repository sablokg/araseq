    <!-- http://purl.obolibrary.org/obo/PO_0005026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0005026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0003011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Multinucleate cell developed by a series of events involving kayokinesis but not cytokinesis of the initial feeding cell. The events are induced by root knot nematodes (e.g., Meloidogyne sp. ) entering the feeding cells (any cells) of the root vascular system.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>c&amp;#233lula gigante de la ra&amp;#237z (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>根巨大細胞 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0005026</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Arabidopsis"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <rdfs:label>root giant cell</rdfs:label>
    </owl:Class>
