            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of plant tissue (PO:0009007) which is a maximal portion of nutritive plant tissue in a seed (PO:0009010).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:149</oboInOwl:hasDbXref>
