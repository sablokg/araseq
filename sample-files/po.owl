    <!-- http://purl.obolibrary.org/obo/PO_0000067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0000067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009005"/>
        <obo:IAO_0000115>A root (PO:0009005) that forms one or more clusters of closely spaced lateral roots (PO:0020121) of limited growth along its length.</obo:IAO_0000115>
        <oboInOwl:created_by>austinmeier</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-08-11T15:05:12Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:588</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cluster root  (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>root cluster (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0000067</oboInOwl:id>
        <rdfs:comment>The terms proteoid root, cluster root, and root cluster have all been used in the literature to describe either the proteoid root axis or clusters of rootlets, and caution should be taken when comparing studies because the definitions of these terms vary (Watts and Evans, 1999; Plant Physiology).</rdfs:comment>
        <rdfs:label>proteoid root</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0000067"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A root (PO:0009005) that forms one or more clusters of closely spaced lateral roots (PO:0020121) of limited growth along its length.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:10517822</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>POC:austin_meier</oboInOwl:hasDbXref>
    </owl:Axiom>
    


