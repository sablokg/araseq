            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A vascular leaf development stage (PO:0025570) during which vascular leaf size increases primarily through cell expansion.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:557</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
