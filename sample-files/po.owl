    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009004">
        <obo:IAO_0000115>OBSOLETE. A plant structure that arises through meiosis and may produce gametes by mitosis.</obo:IAO_0000115>
        <obo:IAO_0100001>PO:0028003</obo:IAO_0100001>
