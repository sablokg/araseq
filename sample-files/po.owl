    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0001014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0001007"/>
        <obo:IAO_0000115>Stage of microgametophyte development during which the asymmetric, first mitotic division of the microspores occurs producing a large vegetative cell and small generative cell, located near pollen wall.</obo:IAO_0000115>
