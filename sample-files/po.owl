        <owl:annotatedTarget>raquis en zarzillo de la hoja (Spanish, exact)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Maria_Alejandra_Gandolfo</oboInOwl:hasDbXref>
