                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0005022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A septum (PO:0000030) that divides a multilocular plant ovary (PO:0009072).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-02-09T10:31:04Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>ovary dissepiment (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FNA:978c1c40-4dee-4bb1-99f6-b2360d1b77b4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:277</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ovary septa (exact, plural)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>septo del ovario (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>子房隔壁   (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>carpel synonym (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0025262</oboInOwl:id>
        <rdfs:comment>Found in species with syncarpous gynoecia (fused carpels). A plant ovary septum is derived from the fused walls of two adjacent carpels, while a replum (PO:0005016) develops from early contact of placental tissue from opposite sides of the plant ovary. Annotations for Arabidopsis should go under replum, not under plant ovary septum.</rdfs:comment>
        <rdfs:label>plant ovary septum</rdfs:label>
    </owl:Class>
