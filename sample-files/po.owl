    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0004011"/>
        <obo:IAO_0000115>An initial cell that is produced by longitudinal division of a sub-apical cell of a protonema.</obo:IAO_0000115>
