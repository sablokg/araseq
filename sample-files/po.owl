                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cardinal organ part that is an appendage at the base of a vascular leaf.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:223</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>est&amp;#237pula (Spanish, exact)</oboInOwl:hasExactSynonym>
