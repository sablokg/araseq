    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0007510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0001031"/>
        <obo:IAO_0000115>The stage at which the fully formed root emerges.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0007510</oboInOwl:id>
        <rdfs:label>root emergence stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
