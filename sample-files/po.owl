    <!-- http://purl.obolibrary.org/obo/PO_0030051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0030051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <obo:IAO_0000115>A portion of plant tissue (PO:0009007) that is an axial strand in the center of a gametophore axis (PO:0030020) or seta (PO:0030032) and has as part a hydrome (PO:0030047) or a leptome (PO:0030048).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-04-25T01:04:07Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:351</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>conducting cylinder (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>conducting strand (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hebra (hilo) central (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>中心束 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0030051</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Bryophytes"/>
        <rdfs:comment>Often contains both hydrome and leptome. Found in bryophytes. The term central strand is sometimes used to describe a protostele in vascular plants, but this ontology class should only be used for non-vascular plants. Analogous to a vein or vascular bundle in vascular plants.</rdfs:comment>
        <rdfs:label>central strand</rdfs:label>
    </owl:Class>
