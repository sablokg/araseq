    <!-- http://purl.obolibrary.org/obo/PO_0003023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0003023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025001"/>
