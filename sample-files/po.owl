        <oboInOwl:id>PO:0001051</oboInOwl:id>
        <rdfs:comment>Localized cell divisions in the peripheral zone (PO:0000225) transition from anticlinal to periclinal divisions.</rdfs:comment>
        <rdfs:label>vascular leaf initiation stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0001051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
