    <!-- http://purl.obolibrary.org/obo/PO_0025523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009005"/>
        <obo:IAO_0000115>A root (PO:0009005) that is radially enlarged relative to other lateral roots (PO:0020121) or shoot-borne roots (PO:0000042) on the same plant, but not as enlarged as a tuberous root tuber (PO:0025476).</obo:IAO_0000115>
        <oboInOwl:created_by>Laurel_Cooper</oboInOwl:created_by>
