    <!-- http://purl.obolibrary.org/obo/PO_0028001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0028001">
        <obo:IAO_0000115>OBSOLETE. A plant growth and development phase that begins with either meiosis or fertilization.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-15T02:54:57Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>fase del ciclo de vida de la plant (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>植物生活環段階 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_structure_development_stage</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0028001</oboInOwl:id>
        <rdfs:comment>The life cycle of all plants is characterized by the alternation of phases (or generations). The sporophytic phase has twice the chromosome complement of the gametophytic phase.</rdfs:comment>
        <rdfs:label>OBSOLETE plant life cycle phase</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0028001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OBSOLETE. A plant growth and development phase that begins with either meiosis or fertilization.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0028001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>fase del ciclo de vida de la plant (Spanish, exact)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:Maria_Alejandra_Gandolfo</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/po#Spanish"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0028001"/>
