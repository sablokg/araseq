            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025194"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cardinal organ part (PO:0025001) that is an outgrowth of a root (PO:0009005) and is inhabited by nitrogen-fixing bacteria.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>nodule (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FNA:b62e2f23-dffc-474a-a7bd-f919ea99b51c</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:235</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>n&amp;#243dulo de la ra&amp;#237z (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>根粒 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0003023</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>Root nodules are a symbiosis between a plant (often, but not exclusively, of the Fabaceae) and bacteria of the genus Rhizobium, Bradyrhizobium, or Azorhizobium.</rdfs:comment>
        <rdfs:label>root nodule</rdfs:label>
