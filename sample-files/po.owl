    <!-- http://purl.obolibrary.org/obo/PO_0025497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009011"/>
        <obo:IAO_0000115>A plant structure (PO:0009011) that is a proper part of a whole plant (PO:0000003) and includes two or more adjacent plant organs (PO:0009008) or adjacent cardinal organ parts (PO:0025001), along with any associated portions of plant tissue (PO:0009007).</obo:IAO_0000115>
        <oboInOwl:created_by>Laurel_Cooper</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-06-11T15:09:20Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:479</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>estructura vegetal colectiva (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>集合的植物構造 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025497</oboInOwl:id>
        <rdfs:comment>This is a parent term to describe both collective organ part structure (PO:0025269)  (e.g. septum), as well as collective plant organ structure (PO:0025007) (which was formerly named collective plant structure), for example shoot system (PO:0009006).</rdfs:comment>
        <rdfs:label>collective plant structure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025497"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A plant structure (PO:0009011) that is a proper part of a whole plant (PO:0000003) and includes two or more adjacent plant organs (PO:0009008) or adjacent cardinal organ parts (PO:0025001), along with any associated portions of plant tissue (PO:0009007).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
