    <!-- http://purl.obolibrary.org/obo/PO_0020034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0020034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009008"/>
        <obo:IAO_0000115>A sheath-like plant organ (PO:0009008) that surrounds the radicle (PO:0020031) of a plant embryo (PO:0009009) or the emerging root (PO:0009005) of a seedling (PO:0000003).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:340</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>coleorriza (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>根鞘 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0020034</oboInOwl:id>
        <rdfs:comment>Found in Poaceae and some other monocots as well as some gymnosperms. Protects the emerging radicle in a plant embryo or seedling. The parenchyma cells of both the coleorhiza and epiblast may function in storage.</rdfs:comment>
        <rdfs:label>coleorhiza</rdfs:label>
    </owl:Class>
